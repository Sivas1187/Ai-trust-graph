{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}
    },
    "fetch": {
      "command": "uvx",
      "args": ["--from", "mcp-server-fetch==0.6.2", "mcp-server-fetch"]
    },
    "aws-ops": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "AWS_PROFILE", "ghcr.io/example/aws-ops-mcp:1.4.0"],
      "env": {"AWS_PROFILE": "agent-ops"}
    }
  }
}
