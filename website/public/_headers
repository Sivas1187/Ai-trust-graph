# Cloudflare Pages response headers for https://aitrustgraph.org (ACTIVE).
#
# Copied to out/_headers by `next build`; scripts/finalize-headers.mjs then
# replaces the hash placeholder in script-src with the SHA-256 hashes of the
# inline scripts Next.js emitted in that same build, so script-src needs no
# 'unsafe-inline'. `npm run build` runs both steps; scripts/check-headers.mjs
# verifies the result. See website/DEPLOYMENT.md in the repository.
#
# Deliberately absent in this iteration: HSTS (owner ruling; enable only after
# production HTTPS stability is verified, never preload) and CSP reporting.
#
# style-src keeps 'unsafe-inline': React style attributes (--i, --level) and the
# <noscript> mobile-menu fallback <style> need it. Scripts do not.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
